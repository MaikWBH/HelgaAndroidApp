# Kopieren nach .env und Werte eintragen: cp .env.example .env
# .env ist gitignored — hier stehen nur Platzhalter, keine echten Secrets.

# Pflicht: Shared Secret zwischen App und Server (Header X-Api-Key).
# Generieren mit: openssl rand -hex 32
API_KEY=hier-ein-langer-zufaelliger-string

# Pflicht: KI-Anbieter für Rezept-Generierung/Remix/Klassifikation/Kassenbon-Scan.
# "openai" oder "anthropic"
AI_PROVIDER=openai

# Pflicht: API-Key des gewählten Anbieters.
AI_API_KEY=sk-dein-api-key

# Optional: Modell-Override für Text-Aufgaben (generate/remix/classify).
# Ohne diese Variable greift ein günstiger Provider-Default.
#   OpenAI:    gpt-4o, gpt-4o-mini
#   Anthropic: claude-sonnet-4-6, claude-haiku-4-5-20251001
# AI_MODEL=gpt-4o-mini

# Optional: eigenes, stärkeres Modell nur für Kassenbon-Scans (parse-receipt).
# Dichte deutsche Kassenbons überfordern Mini-/Haiku-Modelle — siehe server/CLAUDE.md
# Abschnitt "KI-Endpunkte". Fällt ohne diese Variable auf AI_MODEL, dann auf einen
# starken Provider-Default zurück (OpenAI gpt-4o, Anthropic claude-sonnet-4-6).
# AI_VISION_MODEL=claude-sonnet-4-6

# Optional: alternative API-Basis-URL, z. B. für einen OpenAI-kompatiblen Proxy.
# Leer lassen für den offiziellen OpenAI-Endpunkt.
# AI_API_BASE=

# Pfade — passen zum Docker-Volume-Mount in docker-compose*.yml, nicht ändern.
DB_PATH=data/recipes.db
IMAGES_DIR=data/images
