# Vorlage -- kopieren nach `.env` und befuellen. Die echte `.env` wird nie committed.

# Shared Secret fuer den X-Api-Key-Header der App. In Produktion PFLICHT
# (die API ist oeffentlich erreichbar), z.B. erzeugen mit: openssl rand -hex 32
API_KEY=changeme

# ---- KI ----
# Provider: openai | anthropic
AI_PROVIDER=openai
AI_API_KEY=changeme
# Leer = Standard-Endpunkt des Providers
AI_API_BASE=
# Leer = guenstiger Provider-Default
AI_MODEL=
# Modell fuer parse-receipt (muss Bilder koennen), leer = starker Provider-Default
AI_VISION_MODEL=

# ---- Pfade im Container (relativ zu /app) ----
DB_PATH=data/recipes.db
IMAGES_DIR=data/images
