# Vorlage -- kopieren nach `.env` und befuellen. Die echte `.env` wird nie committed.

# Shared Secret fuer den X-Api-Key-Header der App. In Produktion PFLICHT
# (die API ist oeffentlich erreichbar), z.B. erzeugen mit: openssl rand -hex 32
API_KEY=changeme

# ---- KI ----
# Provider: openai | anthropic
AI_PROVIDER=openai
AI_API_KEY=changeme
# Leer = Standard-Endpunkt des Providers
AI_API_BASE=
# Leer = guenstiger Provider-Default
AI_MODEL=
# Nur Referenzmodell fuer scripts/receipt_testset.py (Vergleich gegen das Bon-Modell)
AI_VISION_MODEL=
# Modell fuer ALLE Bon-Aufrufe (muss Bilder koennen). Leer = claude-haiku-5-5 (anthropic)
# bzw. gpt-4o-mini (openai)
AI_RECEIPT_MODEL=
# Aufwand fuer Modelle mit output_config (Haiku 5.5): low | medium | high
AI_RECEIPT_EFFORT=medium
# Nur lokal (Entwicklung, Tests): Start ohne API_KEY erlauben. Niemals in Produktion setzen.
ALLOW_NO_AUTH=
# Log-Level des Servers: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Takt der Re-Parse-Warteschlange fuer Bons in Sekunden, 0 = aus
RECEIPT_QUEUE_INTERVAL_SEC=600

# ---- Pfade im Container (relativ zu /app) ----
DB_PATH=data/recipes.db
IMAGES_DIR=data/images
