# Pflicht: Shared Secret – muss in der Android-App unter X-Api-Key gesetzt werden
API_KEY=change-me-to-a-random-secret

# KI-Provider: "openai" oder "anthropic"
AI_PROVIDER=openai
AI_API_KEY=

# Optional: Modell-Override (z.B. gpt-4o, claude-sonnet-4-6)
AI_MODEL=

# Optional: Benutzerdefinierte API-Basis-URL (für lokale Modelle wie Ollama)
AI_API_BASE=

# Dateipfade (Defaults passen zum Docker-Volume)
DB_PATH=data/recipes.db
IMAGES_DIR=data/images
